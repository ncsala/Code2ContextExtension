{
  "name": "code2context",
  "displayName": "Code2Context",
  "description": "Generate compact code context for AI",
  "version": "0.3.0",
  "engines": {
    "vscode": "^1.99.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ncsala/Code2ContextExtension"
  },
  "publisher": "ncsala",
  "icon": "icon.png",
  "license": "GPL-3.0",
  "author": {
    "name": "Nicolas Caceres Sala",
    "email": "ncsala@gmail.com"
  },
  "keywords": [
    "context",
    "developer-tools",
    "summary",
    "files",
    "ai-assistant",
    "llm",
    "code-export",
    "prompt-engineering",
    "productivity",
    "codebase",
    "copilot-companion"
  ],
  "categories": [
    "Snippets",
    "Formatters",
    "Programming Languages",
    "Other"
  ],
  "preview": false,
  "qna": "marketplace",
  "main": "dist/extension.js",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "build:dev": "webpack --config webpack.config.js --mode development --devtool source-map && pnpm run build-webview",
    "vscode:prepublish": "pnpm run build && pnpm run build-webview",
    "clean": "rimraf ./out ./dist",
    "compile": "tsc --build --clean && tsc -p ./",
    "compile:clean": "pnpm run clean && pnpm run compile",
    "watch": "tsc -watch -p ./",
    "build-webview": "pnpm --dir webview run build",
    "build-all": "pnpm run compile && pnpm run build-webview",
    "build-all:clean": "rimraf ./out ./dist ./webview-dist && pnpm run build-all",
    "pretest": "pnpm run compile:clean && pnpm run lint",
    "lint": "eslint src",
    "vscode:test": "vscode-test",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:debug": "node --inspect-brk node_modules/jest/bin/jest.js --runInBand",
    "package": "pnpm run compile:clean && vsce package --no-dependencies",
    "package:vsix": "pnpm install --frozen-lockfile && pnpm --dir webview install --frozen-lockfile && vsce package --no-dependencies",
    "publish": "pnpm run compile:clean && vsce publish --no-dependencies"
  },
  "contributes": {
    "commands": [
      {
        "command": "code2context.openPanel",
        "title": "Code2Context: Open Generator Panel",
        "icon": "$(files)"
      },
      {
        "command": "code2context.toggleSelection",
        "title": "Toggle File Selection",
        "icon": "$(check)"
      },
      {
        "command": "code2context.selectAll",
        "title": "Select All Files",
        "icon": "$(check-all)"
      },
      {
        "command": "code2context.deselectAll",
        "title": "Deselect All Files",
        "icon": "$(clear-all)"
      },
      {
        "command": "code2context.generateFromSelection",
        "title": "Generate Context from Selected Files",
        "icon": "$(zap)"
      },
      {
        "command": "code2context.generateFromOptions",
        "title": "Generate Context from Current Options",
        "icon": "$(zap)"
      },
      {
        "command": "code2context.selectDirectory",
        "title": "Select Directory and All Children",
        "icon": "$(folder-active)"
      },
      {
        "command": "code2context.selectGitStaged",
        "title": "Select Git Staged Files",
        "category": "Code2Context",
        "icon": "$(git-commit)"
      },
      {
        "command": "code2context.selectGitChanges",
        "title": "Select All Git Changes (staged, unstaged, untracked)",
        "category": "Code2Context",
        "icon": "$(diff)"
      },
      {
        "command": "code2context.extractProject",
        "title": "Code2Context: Recreate Project from Context File",
        "icon": "$(file-zip)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code2context-explorer",
          "title": "Code2Context",
          "icon": "$(zap)"
        }
      ]
    },
    "views": {
      "code2context-explorer": [
        {
          "icon": "$(files)",
          "id": "code2contextFiles",
          "name": "File Selection"
        },
        {
          "icon": "$(settings-gear)",
          "id": "code2contextOptions",
          "name": "Options",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "code2contextFiles",
        "contents": "Select files to include in your context.\n[Select Workspace](command:code2context.openPanel)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "code2context.selectAll",
          "when": "view == code2contextFiles",
          "group": "navigation"
        },
        {
          "command": "code2context.deselectAll",
          "when": "view == code2contextFiles",
          "group": "navigation"
        },
        {
          "command": "code2context.selectGitStaged",
          "when": "view == code2contextFiles",
          "group": "navigation"
        },
        {
          "command": "code2context.selectGitStaged",
          "when": "view == code2contextFiles",
          "group": "1_git@1"
        },
        {
          "command": "code2context.selectGitChanges",
          "when": "view == code2contextFiles",
          "group": "1_git@2"
        },
        {
          "command": "code2context.generateFromSelection",
          "when": "view == code2contextFiles",
          "group": "navigation"
        },
        {
          "command": "code2context.generateFromOptions",
          "when": "view == code2contextOptions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "code2context.toggleSelection",
          "when": "view == code2contextFiles",
          "group": "inline"
        },
        {
          "command": "code2context.selectDirectory",
          "when": "view == code2contextFiles && viewItem == directory",
          "group": "1_modification"
        }
      ]
    }
  },
  "activationEvents": [
    "onView:code2contextFiles",
    "onView:code2contextOptions",
    "onCommand:code2context.openPanel"
  ],
  "dependencies": {
    "ignore": "7.0.4",
    "p-limit": "3.1.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.15.17",
    "@types/vscode": "1.99.1",
    "@typescript-eslint/eslint-plugin": "8.32.0",
    "@typescript-eslint/parser": "8.32.0",
    "@vscode/test-cli": "0.0.10",
    "@vscode/test-electron": "2.5.2",
    "eslint": "9.26.0",
    "jest": "29.7.0",
    "rimraf": "6.0.1",
    "ts-jest": "29.3.2",
    "ts-loader": "9.5.2",
    "typescript": "5.8.3",
    "vsce": "2.15.0",
    "webpack": "5.99.8",
    "webpack-cli": "6.0.1"
  }
}
